# ─── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-...) — from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-...) with connections:write — enables Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret — from Basic Information (used only if you switch off Socket Mode)
SLACK_SIGNING_SECRET=your-signing-secret
# Channel Rewynd listens in. Either the name (incident-response) or the ID (C0123ABCD).
INCIDENT_CHANNEL=incident-response
# Channel the seed script plants the historical incident into. MUST be a public
# channel if the incident channel is public (RTS from a public channel only
# returns public results — spec §7). Defaults to INCIDENT_CHANNEL.
SEED_CHANNEL=incident-response

# ─── Real-Time Search (Layer 2: MemoryService) ──────────────────────────────
# RTS uses SLACK_BOT_TOKEN + the `search:read` scope, and requires Slack AI
# Search on the workspace for SEMANTIC (question-form) retrieval.
RTS_ENABLED=true
# Max results to pull per query (RTS has strict rate limits — kept small; cached per incident).
RTS_RESULT_LIMIT=8

# ─── GitHub MCP (Layer 2: CodeService) ──────────────────────────────────────
# URL of the GitHub MCP server used to ground stack traces against live code.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GitHub token used by the MCP server / for issue creation (repo scope).
GITHUB_TOKEN=ghp_your-github-token
# Repository the incident code lives in, as "owner/name" (e.g. acme/checkout-service).
GITHUB_REPO=your-org/your-repo
# Optional multi-repo routing by stack-trace path prefix. Longest prefix wins.
# Example: src/checkout=your-org/checkout-service,services/billing=your-org/billing-service
GITHUB_REPO_MAP=
# Default branch to read current code from.
GITHUB_DEFAULT_BRANCH=main

# ─── Synthesis LLM (Layer 3: SynthesisService) ──────────────────────────────
# Any OpenAI-compatible /v1/chat/completions endpoint. Pick a free/OSS option:
#   Groq (free):   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Local Ollama:  LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   (LLM_API_KEY can be blank)
# Leave LLM_BASE_URL empty to use the built-in deterministic synthesizer (no LLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ─── Murf TTS (Layer 3: VoiceService) ───────────────────────────────────────
# Murf API key used to render the triage summary to a ~15s audio clip.
MURF_API_KEY=your-murf-api-key
# Murf voice id (see Murf dashboard for options).
MURF_VOICE_ID=en-US-natalie
# Murf generate endpoint (override only if Murf changes it).
MURF_API_URL=https://api.murf.ai/v1/speech/generate

# ─── Runtime ────────────────────────────────────────────────────────────────
# Set to "false" to run over HTTP with a public URL instead of Socket Mode.
SOCKET_MODE=true
PORT=3000
LOG_LEVEL=info
# Force the Layer 1 mocks even when real integrations are configured (offline demos).
USE_MOCKS=false
