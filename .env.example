# ─── Slack ────────────────────────────────────────────────────────────────
# Bot token (xoxb-...) — from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token (xapp-...) with connections:write — enables Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret — from Basic Information (used only if you switch off Socket Mode)
SLACK_SIGNING_SECRET=your-signing-secret
# Channel EchoOps listens in. Either the name (incident-response) or the ID (C0123ABCD).
INCIDENT_CHANNEL=incident-response

# ─── GitHub MCP (Layer: CodeService — real impl arrives in a later layer) ───
# URL of the GitHub MCP server used to ground stack traces against live code.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GitHub token used by the MCP server / for issue creation (repo scope).
GITHUB_TOKEN=ghp_your-github-token

# ─── Murf (Layer: VoiceService — real impl arrives in a later layer) ────────
# Murf API key used to render the triage summary to audio.
MURF_API_KEY=your-murf-api-key

# ─── Runtime ────────────────────────────────────────────────────────────────
# Set to "false" to run over HTTP with a public URL instead of Socket Mode.
SOCKET_MODE=true
PORT=3000
LOG_LEVEL=info
